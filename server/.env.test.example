NODE_ENV=test
PORT=0
LOG_LEVEL=error

# Same host/port as runtime `.env`; only DB_NAME differs (test-only — suites truncate/seed).
DB_HOST=dev-dero.shop
DB_PORT=2000
DB_NAME=cs_quiz_legacy
DB_USER_DEV=quiz_dev
DB_PASSWORD_DEV=your_quiz_dev_password

JWT_SECRET=test_jwt_secret_do_not_use_in_prod
CORS_ORIGIN_LOCAL=http://localhost:5173

# Passport strategies register at import — dummy values are enough for API tests
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback
GITHUB_CLIENT_ID=dummy-github-client-id
GITHUB_CLIENT_SECRET=dummy-github-client-secret
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback
